<div class="glyph-widget">
  {{#if (eq kind "textarea")}}
    <textarea data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" rows="3">{{value}}</textarea>
  {{else if (eq kind "number")}}
    <input type="number" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" {{#if numeric}}
      data-numeric="true" {{/if}} value="{{value}}" {{#if hasMin}} min="{{min}}" {{/if}}{{#if hasMax}} max="{{max}}"
      {{/if}}{{#if hasStep}} step="{{step}}" {{/if}}>
  {{else if (eq kind "formula")}}
    <input type="text" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" value="{{value}}"
      placeholder="2d6+3">
  {{else if (eq kind "boolean")}}
    <input type="checkbox" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}"
      {{checked value}}>
  {{else if (eq kind "select")}}
    <select data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" {{#if numeric}}
      data-numeric="true" {{/if}}{{#if multiple}} multiple{{/if}}>{{selectOptions choices selected=selected}}</select>
  {{else if (eq kind "json")}}
    <input type="text" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" value="{{value}}">
  {{else if (eq kind "uuid")}}
    <document-tags data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" type="{{documentType}}"
      single value="{{value}}"></document-tags>
  {{else if (eq kind "file")}}
    <file-picker data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" type="{{filePickerType}}"
      value="{{value}}"></file-picker>
  {{else if (eq kind "tagRef")}}
    <div class="glyph-tag-ref">
      <input type="text" list="{{listId}}" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}"
        value="{{value}}">
      <datalist id="{{listId}}">{{#each tags}}
          <option value="{{this}}">
        {{/each}}</datalist>
    </div>
  {{else if (eq kind "point")}}
    <div class="glyph-reference" data-document-type="{{documentType}}">
      {{> "modules/glyph/templates/partials/point-mode.hbs" path=path refKind=refKind}}
      {{#if refKind}}
        {{> "modules/glyph/templates/partials/reference-kind.hbs" path=path refKind=refKind}}
        {{> "modules/glyph/templates/partials/reference-value.hbs" refKind=refKind refValuePath=refValuePath
          refValue=refValue refResolvers=refResolvers documentType=documentType}}
      {{else}}
        {{> "modules/glyph/templates/partials/point-coordinates.hbs" path=path x=x y=y elevation=elevation}}
      {{/if}}
    </div>
  {{else if (eq kind "reference")}}
    <div class="glyph-reference" data-document-type="{{documentType}}">
      {{> "modules/glyph/templates/partials/reference-kind.hbs" path=path refKind=refKind}}
      {{> "modules/glyph/templates/partials/reference-value.hbs" refKind=refKind refValuePath=refValuePath
        refValue=refValue refResolvers=refResolvers documentType=documentType}}
    </div>
  {{else if (eq kind "expression")}}
    <input type="text" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" value="{{value}}"
      placeholder="\{{token.name}} == &quot;Goblin&quot;">
  {{else if (eq kind "custom")}}
    {{{html}}}
  {{else}}
    <input type="text" data-path="{{path}}" data-field="{{fieldName}}" data-widget="{{widgetName}}" value="{{value}}">
  {{/if}}
</div>
