<div class="glyph-point-coordinates">
  <label>{{localize "GLYPH.POINT.x"}} <input type="number" data-path="{{path}}.x" data-field="x" value="{{x}}"></label>
  <label>{{localize "GLYPH.POINT.y"}} <input type="number" data-path="{{path}}.y" data-field="y" value="{{y}}"></label>
  <label>{{localize "GLYPH.POINT.elevation"}} <input type="number" data-path="{{path}}.elevation" data-field="elevation"
      value="{{elevation}}"></label>
</div>
