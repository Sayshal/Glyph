<div class="glyph-import-summary">
  <p class="hint">{{localize "GLYPH.IMPORT.hint" tileCount=tileCount}}</p>
  <ul class="glyph-import-totals">
    <li class="glyph-import-ok">{{localize "GLYPH.IMPORT.COUNTS.ok" count=totals.ok}}</li>
    <li class="glyph-import-partial">{{localize "GLYPH.IMPORT.COUNTS.partial" count=totals.partial}}</li>
    <li class="glyph-import-manual">{{localize "GLYPH.IMPORT.COUNTS.manual" count=totals.manual}}</li>
    <li class="glyph-import-skipped">{{localize "GLYPH.IMPORT.COUNTS.skipped" count=totals.skipped}}</li>
  </ul>
</div>
